{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://myportifolio-1-xdlo.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://myportifolio-1-xdlo.onrender.com/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
